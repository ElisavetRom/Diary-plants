{
  "name": "plant-diary",
  "version": "1.0.0",
  "description": "Дневник ухода за комнатными растениями",
  "main": "index.html",
  "scripts": {
    "start": "npx json-server --watch db.json --port 3000",
    "server": "json-server --watch db.json --host 0.0.0.0 --port 10000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "echo '✅ Build completed. Static files are ready.'"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "json-server": "^0.17.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  }
}